# Copy this file to .env and fill in the values. Never commit .env.

# --- Research (Tavily) ---
# Get a free key at https://tavily.com
TAVILY_API_KEY=

# --- Gmail API (OAuth) ---
# Download the OAuth Desktop client JSON from Google Cloud Console and save it
# in the project folder as credentials.json. token.json is created on first sign-in.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# The Gmail address the newsletter is sent from
GMAIL_SENDER=

# Optional display name shown as the sender
GMAIL_SENDER_NAME=

# Recipients are given on demand for each issue, not stored here.
